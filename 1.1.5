#include <stdio.h>

int n, target;
int arr[20];
int subset[20];

int results[10000][20];
int resultSize[10000];
int resultCount = 0;

void saveResult(int size) {
    for (int i = 0; i < size; i++) {
        results[resultCount][i] = subset[i];
    }

    resultSize[resultCount] = size;
    resultCount++;
}

void findSubsets(int index, int sum, int size) {
    if (sum == target) {
        saveResult(size);
        return;
    }

    if (index == n || sum > target) {
        return;
    }

 
    subset[size] = arr[index];
    findSubsets(index + 1, sum + arr[index], size + 1);

    
    findSubsets(index + 1, sum, size);
}

int main() {
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &target);

    findSubsets(0, 0, 0);

    if (resultCount == 0) {
        printf("-1\n");
    } else {
        
        for (int i = resultCount - 1; i >= 0; i--) {
            for (int j = 0; j < resultSize[i]; j++) {
                printf("%d ", results[i][j]);
            }
            }
            printf("\n");
        }
    }

    return 0;
}
