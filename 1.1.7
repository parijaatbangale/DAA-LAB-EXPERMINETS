#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF 999999

// Structure to represent an edge in the graph
struct Edge {
    int u, v, w;
};

void printPath(int parent[], int j, int src) {
    if (j == src) {
        printf("%d", src);
        return;
    }
    printPath(parent, parent[j], src);
    printf("->%d", j);
}

int main() {
    int V, E;
    
    // Read number of vertices and edges
    if (scanf("%d", &V) != 1) return 0;
    if (scanf("%d", &E) != 1) return 0;

    struct Edge* edges = (struct Edge*)malloc(E * sizeof(struct Edge));

    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);
    }

    int src;
    scanf("%d", &src);

    int* dist = (int*)malloc((V + 1) * sizeof(int));
    int* parent = (int*)malloc((V + 1) * sizeof(int));

    // Step 1: Initialize distances from src to all other as INF
    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
}
    dist[src] = 0;

    // Step 2: Relax all edges |V| - 1 times
    for (int i = 1; i <= V - 1; i++) {
        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;
            if (dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
            }
        }
    }

    // Step 3: Check for negative-weight cycles
    int hasNegativeCycle = 0;
    for (int j = 0; j < E; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        int w = edges[j].w;
        if (dist[u] != INF && dist[u] + w < dist[v]) {
            hasNegativeCycle = 1;
            break;
	}
    }

    if (hasNegativeCycle) {
        printf("Negative cycle detected\n");
    } else {
        // Print results for each vertex except the source
        for (int i = 1; i <= V; i++) {
            if (i == src) continue;
            
            if (dist[i] >= INF / 2) {
                printf("%d INF None\n", i);
            } else {
                printf("%d %d ", i, dist[i]);
                printPath(parent, i, src);
                printf("\n");
            }
        }
    }

    free(edges);
    free(dist);
    free(parent);

    return 0;
}
